---
// BudgetCart Admin - Local Development
// This works with Astro's dev server
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BudgetCart Admin</title>
    <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
  </head>
  <body>
    <div id="cms-root">
      <div style="padding: 20px; font-family: system-ui, sans-serif;">
        <h3>⏳ Loading BudgetCart CMS...</h3>
        <p>If this doesn't load, check your internet connection.</p>
      </div>
    </div>
    
    <script>
      console.log("🔧 Initializing BudgetCart Admin...");
      
      function initCMS() {
        const root = document.getElementById('cms-root');
        
        if (typeof CMS === 'undefined') {
          root.innerHTML = `
            <div style="padding: 20px; font-family: system-ui, sans-serif; color: #dc2626;">
              <h3>❌ CMS Failed to Load</h3>
              <p>Please check your internet connection and reload.</p>
              <button onclick="location.reload()" style="padding: 8px 16px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer;">
                Reload
              </button>
            </div>
          `;
          console.error("❌ CMS not available");
          return;
        }
        
        try {
          CMS.init({
            config: {
              backend: {
                name: 'git-gateway',
                branch: 'main',
              },
              media_folder: 'public/images/products',
              public_folder: '/images/products',
              collections: [
                {
                  name: 'products',
                  label: 'Products',
                  folder: 'src/content/products',
                  create: true,
                  slug: '{{slug}}',
                  fields: [
                    { label: 'Product Title', name: 'title', widget: 'string' },
                    { label: 'Price', name: 'price', widget: 'string' },
                    { label: 'Category', name: 'category', widget: 'select', options: ['Tech', 'Fashion', 'Home', 'Kitchen', 'Gadgets', 'Accessories'] },
                    { label: 'Affiliate Link', name: 'affiliateLink', widget: 'string' },
                    { label: 'Platform', name: 'platform', widget: 'select', options: ['Amazon', 'Flipkart', 'Myntra', 'Other'], default: 'Amazon' },
                    { label: 'Product Image', name: 'image', widget: 'image', required: false },
                    { label: 'Rating', name: 'rating', widget: 'number', valueType: 'float', min: 1, max: 5, required: false },
                    { label: 'Short Description', name: 'description', widget: 'text', required: true },
                    { label: 'Full Review', name: 'body', widget: 'markdown' },
                    { label: 'Pros', name: 'pros', widget: 'list', required: false, summary: '{{fields.text}}', field: { label: 'Pro', name: 'text', widget: 'string' } },
                    { label: 'Cons', name: 'cons', widget: 'list', required: false, summary: '{{fields.text}}', field: { label: 'Con', name: 'text', widget: 'string' } }
                  ]
                }
              ]
            }
          });
          
          root.innerHTML = '<div style="padding: 20px; font-family: system-ui, sans-serif;"><h3>✅ CMS Initialized</h3><p>Loading dashboard...</p></div>';
          console.log("✅ CMS initialized successfully");
        } catch (error) {
          console.error("❌ Error:", error);
          root.innerHTML = `
            <div style="padding: 20px; font-family: system-ui, sans-serif; color: #dc2626;">
              <h3>❌ Error Initializing CMS</h3>
              <p>${error.message}</p>
              <pre style="background: #f5f5f5; padding: 10px; border-radius: 4px; overflow: auto; color: #333;">${error.stack}</pre>
            </div>
          `;
        }
      }
      
      // Wait for DOM to load
      if (document.readyState === 'complete') {
        initCMS();
      } else {
        document.addEventListener('DOMContentLoaded', function() {
          setTimeout(initCMS, 1000);
        });
      }
    </script>
  </body>
</html>
