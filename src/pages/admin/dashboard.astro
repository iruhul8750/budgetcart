---
// src/pages/admin/dashboard.astro
import { getCollection } from 'astro:content';
// Import CSS
import './_dashboard.css';

const SITE_URL = import.meta.env.SITE_URL || 'https://budget-cart.onrender.com';
const GITHUB_REPO = import.meta.env.GITHUB_REPO || 'your-username/your-repo';
const GITHUB_BRANCH = import.meta.env.GITHUB_BRANCH || 'dev';

// Fetch products from content collection
let products = [];
try {
  products = await getCollection('products');
} catch (error) {
  console.error('Error loading products:', error);
}

const categories = [...new Set(products.map(p => p.data?.category || 'Uncategorized'))].filter(Boolean);
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BudgetCart Dashboard</title>
</head>
<body>
  <div class="dashboard-container" id="mainContent">
    <!-- Header -->
    <header>
      <h1>🛒 BudgetCart Dashboard</h1>
      <div class="header-actions">
        <span id="userEmail"></span>
        <button class="btn btn-primary" id="addProductBtn">+ Add Product</button>
        <button class="btn-logout" id="logoutBtn">Logout</button>
      </div>
    </header>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="number">{products.length}</div>
        <div class="label">Total Products</div>
      </div>
      <div class="stat-card">
        <div class="number">{categories.length}</div>
        <div class="label">Categories</div>
      </div>
      <div class="stat-card">
        <div class="number">{products.reduce((acc, p) => acc + (p.data?.quantity || 0), 0)}</div>
        <div class="label">Total Stock</div>
      </div>
      <div class="stat-card">
        <div class="number">{(products.reduce((acc, p) => acc + (p.data?.rating || 0), 0) / (products.length || 1)).toFixed(1)}</div>
        <div class="label">Avg Rating</div>
      </div>
      <div class="stat-card">
        <div class="number">{products.filter(p => p.data?.affiliateLink && p.data?.showAffiliate).length}</div>
        <div class="label">Affiliate Products</div>
      </div>
    </div>

    <!-- Products Section with Category Filter inside the same card -->
    <div class="products-section">
      <div class="card">
        <div class="card-header">
          <div class="card-title-section">
            <h2>📦 Products</h2>
            <p style="color: #6b7280; margin-top: 4px; font-size: 0.9rem;">Manage your ecommerce products with affiliate links</p>
          </div>
          <div class="filter-container">
            <label for="categoryFilter">Filter by Category:</label>
            <select id="categoryFilter" class="category-select">
              <option value="all">All Products</option>
              {categories.map(category => (
                <option value={category}>{category}</option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <div id="productsContainer">
        {products.length > 0 ? (
          <div class="product-grid" id="productGrid">
            {products.map((product) => {
              const data = product.data;
              const isFeatured = data?.featured;
              const isBestSeller = data?.bestSeller;
              const isNew = data?.newArrival;
              const isOutOfStock = !data?.inStock || data?.quantity === 0;
              const isAffiliate = data?.affiliateLink && data?.showAffiliate;
              
              let badgeText = '';
              let badgeClass = '';
              if (isAffiliate) { badgeText = '🔗 Affiliate'; badgeClass = 'badge-affiliate'; }
              else if (isFeatured) { badgeText = 'Featured'; badgeClass = 'badge-featured'; }
              else if (isBestSeller) { badgeText = 'Bestseller'; badgeClass = 'badge-bestseller'; }
              else if (isNew) { badgeText = 'New'; badgeClass = 'badge-new'; }
              if (isOutOfStock) { badgeText = 'Out of Stock'; badgeClass = 'badge-outofstock'; }
              
              return (
                <div class="product-card" key={product.slug} data-category={data?.category || 'Uncategorized'} data-slug={product.slug}>
                  {badgeText && <span class={`badge ${badgeClass}`}>{badgeText}</span>}
                  <h3>{data?.title || 'Untitled'}</h3>
                  <div>
                    <span class="price">₹{data?.price || '0'}</span>
                    {data?.originalPrice && data.originalPrice !== data.price && (
                      <span class="original-price">₹{data.originalPrice}</span>
                    )}
                  </div>
                  <span class="category">{data?.category || 'Uncategorized'}</span>
                  {data?.rating > 0 && (
                    <span data-rating={data.rating} style="margin-left: 8px; font-size: 0.8rem;">⭐ {data.rating}</span>
                  )}
                  <div class={`stock ${isOutOfStock ? 'stock-out' : 'stock-in'}`}>
                    {isOutOfStock ? '❌ Out of Stock' : `✅ In Stock (${data?.quantity || 0})`}
                  </div>
                  {data?.tags && data.tags.length > 0 && (
                    <div class="tags">
                      {data.tags.map(tag => <span key={tag}>#{tag}</span>)}
                    </div>
                  )}
                  {isAffiliate && (
                    <div class="affiliate-info">
                      <span>🔗</span>
                      <a href={data.affiliateLink} target="_blank" rel="noopener noreferrer" class="affiliate-link">
                        Affiliate Link
                      </a>
                      {data.affiliateNetwork && (
                        <span class="affiliate-network">• {data.affiliateNetwork}</span>
                      )}
                      {data.commission && (
                        <span class="commission">• {data.commission}</span>
                      )}
                    </div>
                  )}
                  {data?.description && (
                    <div class="description">{data.description}</div>
                  )}
                  <div class="product-actions">
                    <button class="btn btn-warning edit-btn" data-id={product.slug}>Edit</button>
                    <button class="btn btn-danger delete-btn" data-id={product.slug}>Delete</button>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-state">
            <h2>📭 No Products Yet</h2>
            <p>Create your first ecommerce product to get started!</p>
            <button class="btn btn-primary" id="emptyAddBtn">+ Add Product</button>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Product Modal -->
  <div class="modal" id="productModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="modalTitle">Add Product</h2>
        <button type="button" class="modal-close-btn" id="closeModalBtn">✕</button>
      </div>
      <form id="productForm">
        <input type="hidden" id="productId" />
        
        <div class="form-group">
          <label>Product Title <span class="required">*</span></label>
          <input type="text" id="productTitle" required placeholder="Product name" />
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Sale Price (₹) <span class="required">*</span></label>
            <input type="text" id="productPrice" required placeholder="499" />
          </div>
          <div class="form-group">
            <label>Original Price (₹)</label>
            <input type="text" id="productOriginalPrice" placeholder="999" />
          </div>
        </div>
        
        <div class="form-group">
          <label>Category</label>
          <input type="text" id="productCategory" placeholder="Electronics, Books, etc." list="categoryOptions" />
          <datalist id="categoryOptions">
            <option value="Electronics">
            <option value="Books">
            <option value="Clothing">
            <option value="Home & Garden">
            <option value="Sports">
            <option value="Toys">
            <option value="Food">
            <option value="Health & Beauty">
            <option value="Automotive">
            <option value="Accessories">
            <option value="Gadgets">
            <option value="Fashion">
            <option value="Kitchen">
            <option value="Furniture">
            <option value="Beauty">
            <option value="Uncategorized">
          </datalist>
          <div class="hint">Type to add a new category</div>
        </div>
        
        <div class="form-group" style="border-top: 1px solid #e5e7eb; padding-top: 16px;">
          <label style="font-size: 1rem; color: #8b5cf6;">🔗 Affiliate Information</label>
        </div>
        
        <div class="form-group">
          <label>Affiliate Link</label>
          <input type="url" id="productAffiliateLink" placeholder="https://amazon.in/dp/..." />
          <div class="hint">Your affiliate/referral link for this product</div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Affiliate Network</label>
            <input type="text" id="productAffiliateNetwork" placeholder="Amazon, ShareASale, Rakuten" />
          </div>
          <div class="form-group">
            <label>Commission</label>
            <input type="text" id="productCommission" placeholder="10%, ₹50, etc." />
          </div>
        </div>
        
        <div class="form-group">
          <div class="checkbox-group">
            <label>
              <input type="checkbox" id="productShowAffiliate" /> Show Affiliate Link on Product
            </label>
          </div>
          <div class="hint">Enable this to display the affiliate link on the product page</div>
        </div>
        
        <div class="form-group" style="border-top: 1px solid #e5e7eb; padding-top: 16px;">
          <label style="font-size: 1rem;">📦 Inventory & Status</label>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Quantity in Stock</label>
            <input type="number" id="productQuantity" min="0" placeholder="100" />
          </div>
          <div class="form-group">
            <label>Rating (0-5)</label>
            <input type="number" id="productRating" min="0" max="5" step="0.1" placeholder="4.5" />
          </div>
        </div>
        
        <div class="form-group">
          <label>Product Status</label>
          <div class="checkbox-group">
            <label>
              <input type="checkbox" id="productInStock" checked /> In Stock
            </label>
            <label>
              <input type="checkbox" id="productFeatured" /> Featured
            </label>
            <label>
              <input type="checkbox" id="productBestSeller" /> Best Seller
            </label>
            <label>
              <input type="checkbox" id="productNewArrival" /> New Arrival
            </label>
          </div>
        </div>
        
        <div class="form-group">
          <label>Tags (comma separated)</label>
          <input type="text" id="productTags" placeholder="wireless, headphones, premium" />
        </div>
        
        <div class="form-group">
          <label>Description</label>
          <textarea id="productDescription" placeholder="Product description..."></textarea>
        </div>
        
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="saveProductBtn">Save Product</button>
          <button type="button" class="btn btn-close" id="cancelModalBtn">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Modal -->
  <div class="modal" id="deleteModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Delete Product</h2>
        <button type="button" class="modal-close-btn" id="closeDeleteModalBtn">✕</button>
      </div>
      <p>Are you sure you want to delete "<span id="deleteProductName"></span>"?</p>
      <p style="color: #6b7280; font-size: 0.9rem; margin-top: 8px;">This action cannot be undone.</p>
      <div class="form-actions">
        <button class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
        <button class="btn btn-close" id="cancelDeleteBtn">Cancel</button>
      </div>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- CLIENT-SIDE SCRIPTS                         -->
  <!-- ============================================ -->
  
  <!-- Pass data from server to client -->
  <script define:vars={{ SITE_URL, GITHUB_REPO, GITHUB_BRANCH, categories }}>
    // Store server data for the client
    window.__INITIAL_DATA__ = {
      siteUrl: SITE_URL,
      githubRepo: GITHUB_REPO,
      githubBranch: GITHUB_BRANCH,
      categories: categories || []
    };
  </script>

  <!-- Load client-side JavaScript -->
  <script>
    // Dynamically load the dashboard.js file
    const script = document.createElement('script');
    script.src = '/admin/dashboard.js';
    script.type = 'text/javascript';
    document.body.appendChild(script);
  </script>
</body>
</html>