---
// src/pages/admin/dashboard.astro
// Full admin dashboard with CRUD operations
import { getCollection } from 'astro:content';
import fs from 'fs/promises';
import path from 'path';

// Check authentication via cookie/localStorage (client-side check)
const SITE_URL = import.meta.env.SITE_URL || 'http://localhost:4321';

// Get all products
const products = await getCollection('products');
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BudgetCart Dashboard</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #f5f5f5;
      min-height: 100vh;
    }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    
    /* Header */
    header {
      background: white;
      padding: 16px 24px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    header h1 { font-size: 1.5rem; display: flex; align-items: center; gap: 8px; }
    .header-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .logout-btn {
      padding: 8px 20px;
      background: #dc2626;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.9rem;
    }
    .logout-btn:hover { background: #b91c1c; }
    .create-btn {
      padding: 8px 20px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.9rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .create-btn:hover { background: #1d4ed8; }
    
    /* Stats */
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .stat-card {
      background: white;
      padding: 16px 20px;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .stat-card .number { font-size: 1.8rem; font-weight: 700; color: #2563eb; }
    .stat-card .label { font-size: 0.85rem; color: #6b7280; }
    
    /* Products Grid */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
    }
    .product-card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    }
    .product-card .image {
      height: 160px;
      background: #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      color: #9ca3af;
      overflow: hidden;
    }
    .product-card .image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .product-card .content { padding: 16px; }
    .product-card .content h3 {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 4px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .product-card .content .price {
      font-weight: 700;
      color: #16a34a;
      font-size: 1.1rem;
    }
    .product-card .content .category {
      font-size: 0.75rem;
      color: #6b7280;
      background: #f3f4f6;
      padding: 2px 10px;
      border-radius: 12px;
      display: inline-block;
      margin-top: 4px;
    }
    .product-card .actions {
      padding: 12px 16px;
      border-top: 1px solid #f3f4f6;
      display: flex;
      gap: 8px;
    }
    .product-card .actions button {
      padding: 6px 14px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.8rem;
    }
    .btn-edit { background: #e0e7ff; color: #1d4ed8; }
    .btn-edit:hover { background: #c7d2fe; }
    .btn-delete { background: #fee2e2; color: #dc2626; }
    .btn-delete:hover { background: #fecaca; }
    .btn-view { background: #f3f4f6; color: #4b5563; }
    .btn-view:hover { background: #e5e7eb; }
    
    /* Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.active { display: flex; }
    .modal {
      background: white;
      border-radius: 12px;
      padding: 32px;
      max-width: 600px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
    }
    .modal h2 { margin-bottom: 16px; }
    .modal .close-btn {
      float: right;
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: #6b7280;
    }
    .modal .close-btn:hover { color: #1f2937; }
    .form-group { margin-bottom: 14px; }
    .form-group label {
      display: block;
      font-weight: 500;
      margin-bottom: 4px;
      font-size: 0.9rem;
    }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 8px 12px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 0.95rem;
    }
    .form-group textarea { min-height: 100px; resize: vertical; }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .form-actions {
      display: flex;
      gap: 12px;
      margin-top: 16px;
      justify-content: flex-end;
    }
    .form-actions button {
      padding: 8px 24px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.95rem;
    }
    .btn-submit { background: #2563eb; color: white; }
    .btn-submit:hover { background: #1d4ed8; }
    .btn-cancel { background: #e5e7eb; color: #4b5563; }
    .btn-cancel:hover { background: #d1d5db; }
    
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #6b7280;
    }
    .empty-state h2 { font-size: 1.5rem; margin-bottom: 8px; }
    .empty-state p { margin-bottom: 16px; }
    
    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      padding: 12px 24px;
      border-radius: 8px;
      color: white;
      font-weight: 500;
      z-index: 2000;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .toast.show { opacity: 1; }
    .toast.success { background: #16a34a; }
    .toast.error { background: #dc2626; }
    
    @media (max-width: 640px) {
      header { flex-direction: column; align-items: stretch; }
      .header-actions { justify-content: stretch; }
      .header-actions a, .header-actions button { text-align: center; }
      .form-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header>
      <h1>🛒 BudgetCart Dashboard</h1>
      <div class="header-actions">
        <span id="userEmail" style="color: #6b7280; font-size: 0.9rem;"></span>
        <a href="/admin/create" class="create-btn" id="createBtn">➕ New Product</a>
        <button class="logout-btn" id="logoutBtn">Logout</button>
      </div>
    </header>

    <!-- Stats -->
    <div class="stats">
      <div class="stat-card">
        <div class="number" id="totalProducts">{products.length}</div>
        <div class="label">Total Products</div>
      </div>
      <div class="stat-card">
        <div class="number" id="totalCategories">{new Set(products.map(p => p.data.category)).size}</div>
        <div class="label">Categories</div>
      </div>
      <div class="stat-card">
        <div class="number" id="avgRating">{(products.reduce((acc, p) => acc + (p.data.rating || 0), 0) / products.length || 0).toFixed(1)}</div>
        <div class="label">Avg Rating</div>
      </div>
    </div>

    <!-- Products Grid -->
    <div id="productsContainer">
      {products.length > 0 ? (
        <div class="product-grid" id="productGrid">
          {products.map((product) => (
            <div class="product-card" data-id={product.slug}>
              <div class="image">
                {product.data.image ? (
                  <img src={product.data.image} alt={product.data.title} />
                ) : (
                  '📦'
                )}
              </div>
              <div class="content">
                <h3>{product.data.title}</h3>
                <div class="price">{product.data.price}</div>
                <span class="category">{product.data.category}</span>
                {product.data.rating && (
                  <span style="margin-left: 8px; font-size: 0.8rem;">⭐ {product.data.rating}/5</span>
                )}
              </div>
              <div class="actions">
                <button class="btn-view" onclick="viewProduct('{product.slug}')">👁️ View</button>
                <button class="btn-edit" onclick="editProduct('{product.slug}')">✏️ Edit</button>
                <button class="btn-delete" onclick="deleteProduct('{product.slug}')">🗑️ Delete</button>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h2>📭 No Products Yet</h2>
          <p>Create your first product review to get started!</p>
          <a href="/admin/create" class="create-btn">➕ Create Product</a>
        </div>
      )}
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div class="modal-overlay" id="deleteModal">
    <div class="modal">
      <button class="close-btn" onclick="closeDeleteModal()">✕</button>
      <h2>🗑️ Delete Product</h2>
      <p>Are you sure you want to delete <strong id="deleteProductName"></strong>? This action cannot be undone.</p>
      <div class="form-actions">
        <button class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
        <button class="btn-submit" id="confirmDeleteBtn" style="background:#dc2626;">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <script>
    // ─── Authentication Check ───
    const token = localStorage.getItem('github_token');
    if (!token) {
      window.location.href = '/admin';
    }

    // ─── Logout ───
    document.getElementById('logoutBtn').addEventListener('click', () => {
      localStorage.removeItem('github_token');
      document.cookie = 'github_token=; path=/; max-age=0';
      window.location.href = '/admin';
    });

    // ─── Get User Info ───
    async function getUserInfo() {
      try {
        const res = await fetch('https://api.github.com/user', {
          headers: { 'Authorization': `token ${token}` }
        });
        const data = await res.json();
        document.getElementById('userEmail').textContent = data.login || 'User';
      } catch (e) {
        console.error('Error getting user:', e);
      }
    }
    getUserInfo();

    // ─── Toast Notification ───
    let toastTimeout;
    function showToast(message, type = 'success') {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.className = `toast ${type} show`;
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => { toast.classList.remove('show'); }, 3000);
    }

    // ─── Delete Product ───
    let deleteSlug = null;

    window.deleteProduct = function(slug) {
      deleteSlug = slug;
      const name = document.querySelector(`.product-card[data-id="${slug}"] .content h3`)?.textContent || slug;
      document.getElementById('deleteProductName').textContent = name;
      document.getElementById('deleteModal').classList.add('active');
    };

    window.closeDeleteModal = function() {
      document.getElementById('deleteModal').classList.remove('active');
      deleteSlug = null;
    };

    document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
      if (!deleteSlug) return;
      try {
        const res = await fetch(`/api/products/${deleteSlug}`, { method: 'DELETE' });
        if (res.ok) {
          showToast('✅ Product deleted successfully!');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          const data = await res.json();
          showToast('❌ Error: ' + (data.error || 'Unknown error'), 'error');
        }
      } catch (e) {
        showToast('❌ Network error: ' + e.message, 'error');
      }
      closeDeleteModal();
    });

    // ─── View Product ───
    window.viewProduct = function(slug) {
      window.open(`/products/${slug}`, '_blank');
    };

    // ─── Edit Product ───
    window.editProduct = function(slug) {
      window.location.href = `/admin/edit/${slug}`;
    };
  </script>
</body>
</html>