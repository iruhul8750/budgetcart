---
// src/pages/admin/edit/[slug].astro
// Edit product page
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(p => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const data = product?.data;
const slug = product?.slug;
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Product</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; background: #f5f5f5; min-height: 100vh; }
    .container { max-width: 800px; margin: 0 auto; padding: 20px; }
    .card {
      background: white;
      padding: 32px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    h1 { margin-bottom: 8px; display: flex; align-items: center; gap: 12px; }
    .back-link {
      color: #2563eb;
      text-decoration: none;
      font-size: 0.9rem;
    }
    .back-link:hover { text-decoration: underline; }
    .form-group { margin-bottom: 16px; }
    .form-group label {
      display: block;
      font-weight: 500;
      margin-bottom: 4px;
      font-size: 0.9rem;
    }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 0.95rem;
    }
    .form-group textarea { min-height: 120px; resize: vertical; }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .form-actions {
      display: flex;
      gap: 12px;
      margin-top: 20px;
    }
    .btn-submit {
      padding: 10px 32px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.95rem;
    }
    .btn-submit:hover { background: #1d4ed8; }
    .btn-cancel {
      padding: 10px 32px;
      background: #e5e7eb;
      color: #4b5563;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.95rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }
    .btn-cancel:hover { background: #d1d5db; }
    @media (max-width: 640px) { .form-row { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <h1>✏️ Edit Product</h1>
      <a href="/admin/dashboard" class="back-link">← Back to Dashboard</a>
      <form id="editForm" method="POST">
        <input type="hidden" name="slug" value={slug} />
        
        <div class="form-group">
          <label>Product Title *</label>
          <input type="text" name="title" value={data?.title || ''} required />
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Price *</label>
            <input type="text" name="price" value={data?.price || ''} required placeholder="e.g., ₹1,999" />
          </div>
          <div class="form-group">
            <label>Category *</label>
            <select name="category" required>
              <option value="Tech" {data?.category === 'Tech' ? 'selected' : ''}>Tech</option>
              <option value="Fashion" {data?.category === 'Fashion' ? 'selected' : ''}>Fashion</option>
              <option value="Home" {data?.category === 'Home' ? 'selected' : ''}>Home</option>
              <option value="Kitchen" {data?.category === 'Kitchen' ? 'selected' : ''}>Kitchen</option>
              <option value="Gadgets" {data?.category === 'Gadgets' ? 'selected' : ''}>Gadgets</option>
              <option value="Accessories" {data?.category === 'Accessories' ? 'selected' : ''}>Accessories</option>
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Affiliate Link *</label>
            <input type="url" name="affiliateLink" value={data?.affiliateLink || ''} required placeholder="https://amazon.in/dp/..." />
          </div>
          <div class="form-group">
            <label>Platform</label>
            <select name="platform">
              <option value="Amazon" {data?.platform === 'Amazon' ? 'selected' : ''}>Amazon</option>
              <option value="Flipkart" {data?.platform === 'Flipkart' ? 'selected' : ''}>Flipkart</option>
              <option value="Myntra" {data?.platform === 'Myntra' ? 'selected' : ''}>Myntra</option>
              <option value="Other" {data?.platform === 'Other' ? 'selected' : ''}>Other</option>
            </select>
          </div>
        </div>
        
        <div class="form-group">
          <label>Product Image URL</label>
          <input type="url" name="image" value={data?.image || ''} placeholder="/images/products/your-image.jpg" />
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Rating (1-5)</label>
            <input type="number" name="rating" min="1" max="5" step="0.1" value={data?.rating || ''} />
          </div>
        </div>
        
        <div class="form-group">
          <label>Short Description *</label>
          <input type="text" name="description" value={data?.description || ''} required />
        </div>
        
        <div class="form-group">
          <label>Full Review (Markdown) *</label>
          <textarea name="body" required>{data?.body || ''}</textarea>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Pros (one per line)</label>
            <textarea name="pros" rows="3" placeholder="Crystal clear audio&#10;30-hour battery life">{(data?.pros || []).join('\n')}</textarea>
          </div>
          <div class="form-group">
            <label>Cons (one per line)</label>
            <textarea name="cons" rows="3" placeholder="Case feels cheap&#10;No wireless charging">{(data?.cons || []).join('\n')}</textarea>
          </div>
        </div>
        
        <div class="form-actions">
          <button type="submit" class="btn-submit">💾 Save Changes</button>
          <a href="/admin/dashboard" class="btn-cancel">Cancel</a>
        </div>
      </form>
      <div id="status" style="margin-top: 12px;"></div>
    </div>
  </div>

  <script>
    document.getElementById('editForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const status = document.getElementById('status');
      status.textContent = '⏳ Saving...';
      status.style.color = '#6b7280';
      
      const formData = new FormData(form);
      const data = {};
      formData.forEach((value, key) => {
        if (key === 'pros' || key === 'cons') {
          data[key] = value.split('\n').filter(Boolean);
        } else {
          data[key] = value;
        }
      });
      
      try {
        const res = await fetch('/api/products/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (res.ok) {
          status.textContent = '✅ Product updated successfully! Redirecting...';
          status.style.color = '#16a34a';
          setTimeout(() => window.location.href = '/admin/dashboard', 1500);
        } else {
          status.textContent = '❌ Error: ' + (result.error || 'Unknown error');
          status.style.color = '#dc2626';
        }
      } catch (e) {
        status.textContent = '❌ Network error: ' + e.message;
        status.style.color = '#dc2626';
      }
    });
  </script>
</body>
</html>