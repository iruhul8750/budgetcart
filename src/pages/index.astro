---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';

// Import CSS - Only page-specific styles
import './_index.css';

// Fetch all products
const allProducts = await getCollection('products');

// Filter products - only show in-stock products
const products = allProducts.filter(p => p.data?.inStock !== false);

// Get unique categories from products
const categories = [...new Set(products.map(p => p.data?.category || 'Uncategorized'))].filter(Boolean);

// Stats
const totalProducts = products.length;
const avgRating = totalProducts > 0 
  ? (products.reduce((acc, p) => acc + (p.data?.rating || 0), 0) / totalProducts).toFixed(1)
  : 0;

// Featured products (first 6)
const featuredProducts = products.slice(0, 6);
---

<BaseLayout 
  title="BudgetCart - Best Budget Products & Deals" 
  description="Find honest reviews, best deals, and budget-friendly product recommendations at BudgetCart. Save money on tech, fashion, home, and more!"
  categories={categories}
>
  <!-- ============================================ -->
  <!-- BACK TO TOP BUTTON                          -->
  <!-- ============================================ -->
  <button id="backToTop" aria-label="Back to top" title="Back to top">
    ↑
  </button>

  <!-- ============================================ -->
  <!-- HERO SECTION                                -->
  <!-- ============================================ -->
<section id="home" class="hero-section">
  <div class="hero-background">
    <svg class="hero-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path d="M0,0 L100,0 L100,100 L0,100 Z" fill="url(#grid)" />
    </svg>
  </div>
  <div class="hero-content">
    <div class="hero-inner">
      <div class="hero-badge">
        <span class="badge-text">🔥 Budget Finds</span>
      </div>
      <h1 class="hero-title">
        Find the Best <br/>
        <span class="hero-highlight">Budget Products</span>
      </h1>
      <p class="hero-description">
        Honest reviews, real recommendations, and exclusive deals on products you'll love.
      </p>
      <div class="hero-buttons">
        <a href="#products" class="btn-primary">
          Explore Products →
        </a>
        <a href="#about" class="btn-secondary">
          Learn More
        </a>
      </div>
    </div>
  </div>
</section>

  <!-- ============================================ -->
  <!-- STATS SECTION                               -->
  <!-- ============================================ -->
  <section class="stats-section">
    <div class="stats-container">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-number">{totalProducts}+</div>
          <div class="stat-label">Products Reviewed</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">{avgRating}⭐</div>
          <div class="stat-label">Average Rating</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">{categories.length}</div>
          <div class="stat-label">Categories</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">100%</div>
          <div class="stat-label">Honest Reviews</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- FEATURED PRODUCTS SECTION                    -->
  <!-- ============================================ -->
  <section id="featured" class="featured-section">
    <div class="featured-container">
      <div class="featured-header">
        <h2 class="featured-title">
          🔥 Featured <span class="featured-highlight">Budget Finds</span>
        </h2>
        <p class="featured-description">
          Our top picks for the best value products in every category
        </p>
      </div>

      <div class="featured-grid" id="featuredGrid">
        {featuredProducts.map((product) => (
          <ProductCard
            key={product.slug}
            title={product.data.title}
            price={product.data.price}
            originalPrice={product.data.originalPrice}
            image={product.data.image}
            rating={product.data.rating}
            slug={product.slug}
            category={product.data.category}
            inStock={product.data.inStock}
            featured={product.data.featured}
            bestSeller={product.data.bestSeller}
            newArrival={product.data.newArrival}
            description={product.data.description}
            affiliateLink={product.data.affiliateLink}
          />
        ))}
      </div>

      <div class="featured-footer">
        <a href="#products" class="view-all-btn">
          View All Products
          <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ALL PRODUCTS SECTION                         -->
  <!-- ============================================ -->
  <section id="products" class="products-section">
    <div class="products-container">
      <div class="products-header">
        <h2 class="products-title">
          🛍️ All <span class="products-highlight">Products</span>
        </h2>
        <p class="products-description">
          Browse our complete collection of budget-friendly products
        </p>
      </div>

      {products.length > 0 ? (
        <div class="products-grid" id="productsGrid">
          {products.map((product) => (
            <ProductCard
              key={product.slug}
              title={product.data.title}
              price={product.data.price}
              originalPrice={product.data.originalPrice}
              image={product.data.image}
              rating={product.data.rating}
              slug={product.slug}
              category={product.data.category}
              inStock={product.data.inStock}
              featured={product.data.featured}
              bestSeller={product.data.bestSeller}
              newArrival={product.data.newArrival}
              description={product.data.description}
              affiliateLink={product.data.affiliateLink}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-icon">📭</div>
          <h2 class="empty-title">No Products Available</h2>
          <p class="empty-description">Check back later for new products!</p>
        </div>
      )}
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ABOUT SECTION                               -->
  <!-- ============================================ -->
  <section id="about" class="about-section">
    <div class="about-container">
      <div class="about-header">
        <h2 class="about-title">
          About <span class="about-highlight">BudgetCart</span>
        </h2>
        <div class="about-divider"></div>
      </div>

      <div class="about-content">
        <!-- Main Content -->
        <div class="about-main">
          <div class="about-text">
            <div class="about-icon">🛒</div>
            <h3 class="about-subtitle">Your Trusted Budget Shopping Companion</h3>
            <p class="about-paragraph">
              BudgetCart was founded with a simple mission: <strong>help people find the best products at the best prices</strong>. We believe that quality products shouldn't break the bank, and everyone deserves access to honest, unbiased reviews.
            </p>
            <p class="about-paragraph">
              Unlike other review sites that accept sponsorships, we <strong>buy and test every product ourselves</strong>. Our team of experts spends countless hours researching, comparing, and reviewing products so you don't have to.
            </p>
            <div class="about-features">
              <div class="about-feature">
                <span class="feature-check">✓</span>
                <span class="feature-text">100% Honest Reviews</span>
              </div>
              <div class="about-feature">
                <span class="feature-check">✓</span>
                <span class="feature-text">Real Product Testing</span>
              </div>
              <div class="about-feature">
                <span class="feature-check">✓</span>
                <span class="feature-text">Best Price Guarantee</span>
              </div>
            </div>
          </div>

          <div class="about-stats-card">
            <h4 class="stats-card-title">📊 Quick Facts</h4>
            <div class="stats-list">
              <div class="stats-item">
                <span class="stats-label">Products Reviewed</span>
                <span class="stats-value">{totalProducts}+</span>
              </div>
              <div class="stats-item">
                <span class="stats-label">Categories</span>
                <span class="stats-value">{categories.length}</span>
              </div>
              <div class="stats-item">
                <span class="stats-label">Average Rating</span>
                <span class="stats-value">{avgRating} ⭐</span>
              </div>
              <div class="stats-item">
                <span class="stats-label">Founded</span>
                <span class="stats-value">2024</span>
              </div>
              <div class="stats-item">
                <span class="stats-label">Review Accuracy</span>
                <span class="stats-value highlight">100% Honest</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature Cards -->
        <div class="feature-cards">
          <div class="feature-card">
            <div class="feature-card-icon">🔍</div>
            <h4 class="feature-card-title">Transparency</h4>
            <p class="feature-card-text">
              We disclose everything - no hidden agendas, no sponsored reviews. Just honest opinions.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-card-icon">💰</div>
            <h4 class="feature-card-title">Value for Money</h4>
            <p class="feature-card-text">
              We focus on products that offer the best quality for the price, helping you save money.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-card-icon">🛡️</div>
            <h4 class="feature-card-title">Trust</h4>
            <p class="feature-card-text">
              Our community trusts us because we consistently deliver reliable, accurate reviews.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- NEWSLETTER SECTION                          -->
  <!-- ============================================ -->
  <section class="newsletter-section">
    <div class="newsletter-container">
      <h2 class="newsletter-title">📬 Get Budget Deals in Your Inbox</h2>
      <p class="newsletter-description">
        Subscribe to get the best budget finds and exclusive deals delivered weekly.
      </p>
      <form class="newsletter-form" id="newsletterForm">
        <input 
          type="email" 
          placeholder="Enter your email" 
          class="newsletter-input"
          id="newsletterEmail"
          required
        />
        <button type="submit" class="newsletter-button" id="newsletterSubmit">
          Subscribe Free →
        </button>
      </form>
      <p class="newsletter-note">No spam. Unsubscribe anytime.</p>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- JAVASCRIPT - External File                  -->
  <!-- ============================================ -->
  <script is:inline src="/index.js"></script>
</BaseLayout>