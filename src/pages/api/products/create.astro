---
// src/pages/api/products/create.astro
// API endpoint for creating products
export const prerender = false;

import fs from 'fs/promises';
import path from 'path';

export async function POST({ request }) {
  try {
    const body = await request.json();
    const { title, price, category, affiliateLink, platform, image, rating, description, body: content, pros, cons } = body;
    
    // Validate required fields
    if (!title || !price || !category || !affiliateLink || !description || !content) {
      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400 });
    }
    
    // Generate slug from title
    const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    
    // Build frontmatter
    const frontmatter = {
      title,
      price,
      category,
      affiliateLink,
      platform: platform || 'Amazon',
      image: image || '',
      rating: rating ? parseFloat(rating) : undefined,
      description,
      pros: pros || [],
      cons: cons || [],
      pubDate: new Date().toISOString().split('T')[0]
    };
    
    // Build markdown content
    let mdContent = '---\n';
    for (const [key, value] of Object.entries(frontmatter)) {
      if (value === undefined || value === null) continue;
      if (Array.isArray(value)) {
        mdContent += `${key}:\n`;
        for (const item of value) {
          mdContent += `  - "${item}"\n`;
        }
      } else if (typeof value === 'string' && (value.includes('\n') || value.includes('"'))) {
        mdContent += `${key}: "${value.replace(/"/g, '\\"')}"\n`;
      } else {
        mdContent += `${key}: ${value}\n`;
      }
    }
    mdContent += '---\n\n';
    mdContent += content;
    
    // Save to file
    const filePath = path.join(process.cwd(), 'src', 'content', 'products', `${slug}.md`);
    await fs.writeFile(filePath, mdContent, 'utf-8');
    
    return new Response(JSON.stringify({ success: true, slug }), { status: 200 });
  } catch (error) {
    console.error('Create error:', error);
    return new Response(JSON.stringify({ error: error.message }), { status: 500 });
  }
}