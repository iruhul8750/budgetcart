---
// src/pages/categories/[category].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allProducts = await getCollection('products');
  
  const categories = [...new Set(
    allProducts
      .filter(p => p.data?.inStock !== false)
      .map(p => p.data?.category || 'Uncategorized')
  )].filter(Boolean);
  
  if (categories.length === 0) {
    return [];
  }
  
  return categories.map(category => ({
    params: { 
      category: category.toLowerCase().replace(/ /g, '-') 
    },
    props: { 
      category: category 
    }
  }));
}

const { category } = Astro.props;

if (!category) {
  return (
    <BaseLayout title="Category Not Found" categories={[]}>
      <div class="max-w-7xl mx-auto px-4 py-16 text-center">
        <h1 class="text-4xl font-bold text-gray-800 mb-4">Category Not Found</h1>
        <p class="text-gray-600">The category you're looking for doesn't exist.</p>
        <a href="/" class="inline-block mt-4 text-blue-600 hover:text-blue-700 font-semibold">
          ← Back to Home
        </a>
      </div>
    </BaseLayout>
  );
}

const allProducts = await getCollection('products');

const categoryProducts = allProducts.filter(p => 
  p.data?.category === category && 
  p.data?.inStock !== false
);

const allCategories = [...new Set(
  allProducts.map(p => p.data?.category || 'Uncategorized')
)].filter(Boolean);

const categoryEmoji = {
  'Tech': '💻',
  'Fashion': '👕',
  'Home': '🏠',
  'Kitchen': '🍳',
  'Accessories': '⌚',
  'Gadgets': '📱',
  'Electronics': '📱',
  'Books': '📚',
  'Clothing': '👔',
  'Health & Beauty': '💄',
  'Sports': '⚽',
  'Toys': '🧸',
  'Food': '🍕',
  'Automotive': '🚗',
}[category] || '📦';

const categoryDisplayName = category || 'Category';
---

<BaseLayout 
  title={`${categoryDisplayName} Products - BudgetCart`}
  description={`Browse the best ${categoryDisplayName} products at BudgetCart.`}
  categories={allCategories}
>
  <div class="max-w-7xl mx-auto px-4 py-6">
    <!-- Category Header -->
    <div class="mb-6">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-3xl">{categoryEmoji}</span>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-800">
          {categoryDisplayName}
        </h1>
        <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">
          {categoryProducts.length} products
        </span>
      </div>
      <p class="text-gray-600 text-sm">
        Browse our collection of budget-friendly {categoryDisplayName.toLowerCase()} products
      </p>
      <a href="/" class="text-blue-600 hover:text-blue-700 text-xs inline-flex items-center gap-1 mt-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Home
      </a>
    </div>

    <!-- Products Grid -->
    {categoryProducts.length > 0 ? (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
        {categoryProducts.map((product) => (
          <ProductCard
            key={product.slug}
            title={product.data.title}
            price={product.data.price}
            originalPrice={product.data.originalPrice}
            image={product.data.image}
            rating={product.data.rating}
            slug={product.slug}
            category={product.data.category}
            inStock={product.data.inStock}
            featured={product.data.featured}
            bestSeller={product.data.bestSeller}
            newArrival={product.data.newArrival}
            description={product.data.description}
            affiliateLink={product.data.affiliateLink}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <div class="text-6xl mb-4">📭</div>
        <h2 class="text-2xl font-bold text-gray-700 mb-2">No Products Found</h2>
        <p class="text-gray-500">No products available in this category yet.</p>
        <a href="/" class="inline-block mt-4 text-blue-600 hover:text-blue-700 font-semibold text-sm">
          ← Back to Home
        </a>
      </div>
    )}
  </div>
</BaseLayout>