---
// src/layouts/BaseLayout.astro
export interface Props {
  title: string;
  description?: string;
  categories?: string[];
}

const { title, description, categories = [] } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content="index, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Layout CSS -->
  <link rel="stylesheet" href="/styles/layout.css" />
</head>
<body>
  <!-- ============================================ -->
  <!-- HEADER - ALWAYS FIXED                      -->
  <!-- ============================================ -->
  <header class="main-header" id="mainHeader">
    <div class="header-container">
      <a href="/" class="header-logo">
        <svg class="logo-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
        <span class="logo-text">BudgetCart</span>
      </a>
      
      <!-- Desktop Navigation -->
      <nav class="desktop-nav">
        <a href="/" class="nav-link active" data-page="home">Home</a>
        <a href="/#featured" class="nav-link" data-page="featured">Featured</a>
        <a href="/#products" class="nav-link" data-page="products">Products</a>
        <a href="/#about" class="nav-link" data-page="about">About</a>
        <div class="dropdown">
          <span class="nav-link flex items-center gap-1 cursor-pointer">
            Categories
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </span>
          <div class="dropdown-content">
            {categories && categories.length > 0 ? (
              categories.map((category) => {
                const emoji = {
                  'Tech': '💻', 'Fashion': '👕', 'Home': '🏠', 'Kitchen': '🍳',
                  'Accessories': '⌚', 'Gadgets': '📱', 'Electronics': '📱',
                  'Books': '📚', 'Clothing': '👔', 'Health & Beauty': '💄',
                  'Sports': '⚽', 'Toys': '🧸', 'Food': '🍕', 'Automotive': '🚗'
                }[category] || '📦';
                return (
                  <a href={`/categories/${category.toLowerCase().replace(/ /g, '-')}`} key={category}>
                    <span class="dropdown-emoji">{emoji}</span>{category}
                  </a>
                );
              })
            ) : <a href="/#categories">No Categories</a>}
          </div>
        </div>
      </nav>

      <div class="header-actions">
        <!-- Dark Mode Toggle -->
        <button id="darkModeToggle" class="dark-mode-toggle" aria-label="Toggle dark mode">
          <span class="moon-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3
                      7 7 0 0 0 21 12.79z"></path>
            </svg>
          </span>

          <span class="sun-icon" aria-hidden="true">☀️</span>
        </button>

        <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Menu">
          <svg class="menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div class="mobile-nav" id="mobileNav">
      <div class="mobile-nav-inner">
        <a href="/" class="mobile-nav-link active" data-page="home">Home</a>
        <a href="/#featured" class="mobile-nav-link" data-page="featured">Featured</a>
        <a href="/#products" class="mobile-nav-link" data-page="products">Products</a>
        <a href="/#about" class="mobile-nav-link" data-page="about">About</a>
        
        <!-- Mobile Categories Dropdown -->
        <div class="mobile-dropdown-wrapper">
          <button class="mobile-dropdown-toggle" id="mobileCategoriesToggle">
            <span>📦 Categories</span>
            <svg class="dropdown-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="mobile-dropdown-content" id="mobileCategoriesContent">
            {categories && categories.length > 0 ? (
              categories.map((category) => {
                const emoji = {
                  'Tech': '💻', 'Fashion': '👕', 'Home': '🏠', 'Kitchen': '🍳',
                  'Accessories': '⌚', 'Gadgets': '📱', 'Electronics': '📱',
                  'Books': '📚', 'Clothing': '👔', 'Health & Beauty': '💄',
                  'Sports': '⚽', 'Toys': '🧸', 'Food': '🍕', 'Automotive': '🚗'
                }[category] || '📦';
                return (
                  <a href={`/categories/${category.toLowerCase().replace(/ /g, '-')}`} key={category} class="mobile-dropdown-link">
                    <span>{emoji}</span> {category}
                  </a>
                );
              })
            ) : <a href="/#categories" class="mobile-dropdown-link">No Categories</a>}
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ============================================ -->
  <!-- MAIN CONTENT                                -->
  <!-- ============================================ -->
  <main>
    <slot />
  </main>

  <!-- ============================================ -->
  <!-- FOOTER                                      -->
  <!-- ============================================ -->
  <footer class="main-footer">
    <div class="footer-container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <svg class="footer-logo-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            <span>BudgetCart</span>
          </a>
          <p class="footer-description">Find the best budget products with honest reviews from real users.</p>
          <div class="footer-social">
            <a href="#" class="social-link" aria-label="Email">📧</a>
            <a href="#" class="social-link" aria-label="Twitter">🐦</a>
            <a href="#" class="social-link" aria-label="Instagram">📸</a>
            <a href="#" class="social-link" aria-label="YouTube">▶️</a>
          </div>
        </div>

        <div class="footer-section">
          <h4 class="footer-section-title">Categories</h4>
          <ul class="footer-links">
            {categories && categories.slice(0, 5).map((category) => (
              <li key={category}><a href={`/categories/${category.toLowerCase().replace(/ /g, '-')}`}>{category}</a></li>
            ))}
            {categories && categories.length > 5 && <li><a href="/#categories" class="text-blue-400">View All →</a></li>}
          </ul>
        </div>

        <div class="footer-section">
          <h4 class="footer-section-title">Quick Links</h4>
          <ul class="footer-links">
            <li><a href="/about">About Us</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/submit">Submit Product</a></li>
          </ul>
        </div>

        <div class="footer-section">
          <h4 class="footer-section-title">Legal</h4>
          <ul class="footer-links">
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Service</a></li>
            <li><a href="/disclosure">Affiliate Disclosure</a></li>
            <li><a href="/cookies">Cookie Policy</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-copy">© {new Date().getFullYear()} BudgetCart. All rights reserved.</p>
        <p class="footer-disclosure">We may earn a commission through affiliate links at no extra cost to you.</p>
      </div>
    </div>
  </footer>

  <!-- ============================================ -->
  <!-- JAVASCRIPT - External File                  -->
  <!-- ============================================ -->
  <script is:inline src="/layout.js"></script>
</body>
</html>