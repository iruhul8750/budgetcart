---
// src/components/ProductCard.astro
export interface Props {
  title: string;
  price: string;
  originalPrice?: string;
  image?: string;
  rating?: number;
  slug: string;
  category?: string;
  inStock?: boolean;
  featured?: boolean;
  bestSeller?: boolean;
  newArrival?: boolean;
  description?: string;
  affiliateLink?: string;
}

const {
  title,
  price,
  originalPrice,
  image,
  rating,
  slug,
  category,
  inStock = true,
  featured = false,
  bestSeller = false,
  newArrival = false,
  description,
  affiliateLink,
} = Astro.props;

const hasDiscount = originalPrice && originalPrice !== price;
const isOutOfStock = !inStock;
const discountAmount = hasDiscount ? parseFloat(originalPrice) - parseFloat(price) : 0;

// Determine badge
let badgeText = '';
let badgeColor = '';
if (isOutOfStock) {
  badgeText = 'Out of Stock';
  badgeColor = 'bg-gray-500';
} else if (bestSeller) {
  badgeText = '⭐ Bestseller';
  badgeColor = 'bg-red-500';
} else if (featured) {
  badgeText = '🔥 Featured';
  badgeColor = 'bg-orange-500';
} else if (newArrival) {
  badgeText = '✨ New';
  badgeColor = 'bg-green-500';
}
---

<div class="product-card bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden group h-full flex flex-col">
  <!-- Image - Square and small -->
  <div class="relative overflow-hidden bg-gray-100 aspect-square w-full">
    {image ? (
      <img 
        src={image} 
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        width="200"
        height="200"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-4xl text-gray-300">
        🛒
      </div>
    )}
    
    <!-- Badge -->
    {badgeText && (
      <span class={`absolute top-2 left-2 ${badgeColor} text-white text-[0.6rem] font-bold px-2 py-0.5 rounded-full`}>
        {badgeText}
      </span>
    )}
    
    <!-- Stock Badge -->
    {isOutOfStock && (
      <span class="absolute bottom-2 left-2 bg-black/70 text-white text-[0.6rem] font-bold px-2 py-0.5 rounded-full">
        Out of Stock
      </span>
    )}
  </div>

  <!-- Content - Compact -->
  <div class="p-3 flex flex-col flex-grow">
    <!-- Category -->
    {category && (
      <span class="text-[0.6rem] text-blue-600 font-medium bg-blue-50 px-2 py-0.5 rounded-full inline-block mb-1 self-start">
        {category}
      </span>
    )}

    <!-- Title -->
    <a href={`/products/${slug}`} class="block">
      <h3 class="font-semibold text-gray-800 hover:text-blue-600 transition-colors line-clamp-2 text-sm">
        {title}
      </h3>
    </a>

    <!-- Rating -->
    {rating && rating > 0 && (
      <div class="flex items-center gap-0.5 mt-0.5">
        <span class="text-yellow-400 text-xs">★</span>
        <span class="text-xs font-medium text-gray-700">{rating.toFixed(1)}</span>
        <span class="text-[0.6rem] text-gray-400">/ 5</span>
      </div>
    )}

    <!-- Price -->
    <div class="mt-1 flex items-center gap-1.5 flex-wrap">
      <span class="text-base font-bold text-blue-600">
        ₹{price}
      </span>
      {hasDiscount && (
        <span class="text-xs text-gray-400 line-through">
          ₹{originalPrice}
        </span>
      )}
      {hasDiscount && discountAmount > 0 && (
        <span class="text-[0.6rem] font-semibold text-green-600 bg-green-50 px-1.5 py-0.5 rounded-full">
          Save ₹{discountAmount}
        </span>
      )}
    </div>

    <!-- Buy Button instead of Details -->
    {affiliateLink && !isOutOfStock ? (
      <a 
        href={affiliateLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 w-full block text-center px-4 py-1.5 rounded-lg font-medium transition-colors text-sm bg-orange-500 text-white hover:bg-orange-600"
      >
        Buy Now 🛒
      </a>
    ) : (
      <a 
        href={`/products/${slug}`}
        class={`mt-2 w-full block text-center px-4 py-1.5 rounded-lg font-medium transition-colors text-sm ${
          isOutOfStock 
            ? 'bg-gray-200 text-gray-400 cursor-not-allowed' 
            : 'bg-blue-600 text-white hover:bg-blue-700'
        }`}
        {...(isOutOfStock ? { onclick: 'return false;' } : {})}
      >
        {isOutOfStock ? 'Out of Stock' : 'View Details →'}
      </a>
    )}
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .product-card {
    transition: transform 0.2s;
  }
  
  .product-card:hover {
    transform: translateY(-3px);
  }
  
  .aspect-square {
    aspect-ratio: 1 / 1;
  }
  
  .self-start {
    align-self: flex-start;
  }
  
  .flex-grow {
    flex-grow: 1;
  }
  
  .flex-col {
    flex-direction: column;
  }
  
  .h-full {
    height: 100%;
  }
</style>