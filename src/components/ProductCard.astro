---
// src/components/ProductCard.astro
export interface Props {
  title: string;
  price: string;
  originalPrice?: string;
  image?: string;
  rating?: number;
  slug: string;
  category?: string;
  inStock?: boolean;
  featured?: boolean;
  bestSeller?: boolean;
  newArrival?: boolean;
  description?: string;
  affiliateLink?: string;
}

const {
  title,
  price,
  originalPrice,
  image,
  rating,
  slug,
  category,
  inStock = true,
  featured = false,
  bestSeller = false,
  newArrival = false,
  description,
  affiliateLink,
} = Astro.props;

const hasDiscount = originalPrice && originalPrice !== price;
const isOutOfStock = !inStock;
const discountAmount = hasDiscount ? parseFloat(originalPrice) - parseFloat(price) : 0;

// Determine badge
let badgeText = '';
let badgeColor = '';
if (isOutOfStock) {
  badgeText = 'Out of Stock';
  badgeColor = 'badge-outofstock';
} else if (bestSeller) {
  badgeText = '⭐ Bestseller';
  badgeColor = 'badge-bestseller';
} else if (featured) {
  badgeText = '🔥 Featured';
  badgeColor = 'badge-featured';
} else if (newArrival) {
  badgeText = '✨ New';
  badgeColor = 'badge-new';
}
---

<div class="product-card">
  <!-- Image -->
  <div class="product-image-wrapper">
    {image ? (
      <img 
        src={image} 
        alt={title}
        class="product-image"
        loading="lazy"
        width="200"
        height="200"
      />
    ) : (
      <div class="product-image-placeholder">
        🛒
      </div>
    )}
    
    <!-- Badge -->
    {badgeText && (
      <span class={`product-badge ${badgeColor}`}>
        {badgeText}
      </span>
    )}
    
    <!-- Stock Badge -->
    {isOutOfStock && (
      <span class="product-badge badge-outofstock">
        Out of Stock
      </span>
    )}
  </div>

  <!-- Content -->
  <div class="product-content">
    <!-- Category -->
    {category && (
      <span class="product-category">
        {category}
      </span>
    )}

    <!-- Title -->
    <a href={`/products/${slug}`} class="product-title-link">
      <h3 class="product-title">
        {title}
      </h3>
    </a>

    <!-- Rating -->
    {rating && rating > 0 && (
      <div class="product-rating">
        <span class="rating-star">★</span>
        <span class="rating-value">{rating.toFixed(1)}</span>
        <span class="rating-max">/ 5</span>
      </div>
    )}

    <!-- Price -->
    <div class="product-price-wrapper">
      <span class="product-price">₹{price}</span>
      {hasDiscount && (
        <span class="product-price-original">₹{originalPrice}</span>
      )}
      {hasDiscount && discountAmount > 0 && (
        <span class="product-discount">
          Save ₹{discountAmount}
        </span>
      )}
    </div>

    <!-- Button -->
    {affiliateLink && !isOutOfStock ? (
      <a 
        href={affiliateLink}
        target="_blank"
        rel="noopener noreferrer"
        class="product-btn product-btn-buy"
      >
        Buy Now 🛒
      </a>
    ) : (
      <a 
        href={`/products/${slug}`}
        class={`product-btn ${isOutOfStock ? 'product-btn-outofstock' : 'product-btn-view'}`}
        {...(isOutOfStock ? { onclick: 'return false;' } : {})}
      >
        {isOutOfStock ? 'Out of Stock' : 'View Details →'}
      </a>
    )}
  </div>
</div>

<style is:global>
  /* ============================================ */
  /* PRODUCT CARD STYLES - GLOBAL                */
  /* ============================================ */

  .product-card {
    background: var(--bg-card, #ffffff);
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px var(--shadow-color, rgba(0, 0, 0, 0.1));
    transition: all 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--border-color, #e5e7eb);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px var(--shadow-color, rgba(0, 0, 0, 0.15));
  }

  /* Image Wrapper */
  .product-image-wrapper {
    position: relative;
    overflow: hidden;
    background: var(--bg-secondary, #f3f4f6);
    aspect-ratio: 1 / 1;
    width: 100%;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .product-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: var(--text-secondary, #9ca3af);
  }

  /* Badges */
  .product-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .badge-featured {
    background: #f59e0b;
  }

  .badge-bestseller {
    background: #dc2626;
  }

  .badge-new {
    background: #16a34a;
  }

  .badge-outofstock {
    background: #6b7280;
  }

  /* Content */
  .product-content {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  /* Category */
  .product-category {
    font-size: 0.6rem;
    color: #2563eb;
    font-weight: 600;
    background: #eff6ff;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    display: inline-block;
    margin-bottom: 0.25rem;
    align-self: flex-start;
  }

  /* Title */
  .product-title-link {
    display: block;
    text-decoration: none;
  }

  .product-title {
    font-weight: 600;
    color: var(--text-primary, #1f2937);
    transition: color 0.3s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
    font-size: 0.875rem;
    margin: 0;
  }

  .product-title-link:hover .product-title {
    color: #2563eb;
  }

  /* Rating */
  .product-rating {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin-top: 0.125rem;
  }

  .rating-star {
    color: #fbbf24;
    font-size: 0.75rem;
  }

  .rating-value {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-primary, #374151);
  }

  .rating-max {
    font-size: 0.6rem;
    color: var(--text-secondary, #9ca3af);
  }

  /* Price */
  .product-price-wrapper {
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .product-price {
    font-size: 1rem;
    font-weight: 700;
    color: #2563eb;
  }

  .product-price-original {
    font-size: 0.75rem;
    color: var(--text-secondary, #9ca3af);
    text-decoration: line-through;
  }

  .product-discount {
    font-size: 0.6rem;
    font-weight: 600;
    color: #16a34a;
    background: #f0fdf4;
    padding: 0.125rem 0.375rem;
    border-radius: 9999px;
  }

  /* Buttons */
  .product-btn {
    margin-top: 0.5rem;
    width: 100%;
    display: block;
    text-align: center;
    padding: 0.375rem 1rem;
    border-radius: 0.5rem;
    font-weight: 500;
    transition: all 0.3s ease;
    font-size: 0.875rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  .product-btn-buy {
    background: #f59e0b;
    color: white;
  }

  .product-btn-buy:hover {
    background: #d97706;
    transform: translateY(-1px);
  }

  .product-btn-view {
    background: #2563eb;
    color: white;
  }

  .product-btn-view:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
  }

  .product-btn-outofstock {
    background: var(--bg-secondary, #e5e7eb);
    color: var(--text-secondary, #9ca3af);
    cursor: not-allowed;
  }

  /* ============================================ */
  /* DARK MODE STYLES                            */
  /* ============================================ */

  .dark-mode .product-card {
    background: #1f2937;
    border-color: #374151;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
  }

  .dark-mode .product-card:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4);
  }

  .dark-mode .product-image-wrapper {
    background: #111827;
  }

  .dark-mode .product-image-placeholder {
    color: #4b5563;
  }

  .dark-mode .product-title {
    color: #f9fafb;
  }

  .dark-mode .product-title-link:hover .product-title {
    color: #60a5fa;
  }

  .dark-mode .product-category {
    color: #60a5fa;
    background: rgba(96, 165, 250, 0.15);
  }

  .dark-mode .rating-value {
    color: #f9fafb;
  }

  .dark-mode .rating-max {
    color: #6b7280;
  }

  .dark-mode .product-price {
    color: #60a5fa;
  }

  .dark-mode .product-price-original {
    color: #6b7280;
  }

  .dark-mode .product-discount {
    color: #4ade80;
    background: rgba(74, 222, 128, 0.15);
  }

  .dark-mode .product-btn-buy {
    background: #d97706;
  }

  .dark-mode .product-btn-buy:hover {
    background: #b45309;
  }

  .dark-mode .product-btn-view {
    background: #3b82f6;
  }

  .dark-mode .product-btn-view:hover {
    background: #2563eb;
  }

  .dark-mode .product-btn-outofstock {
    background: #374151;
    color: #6b7280;
  }

  /* ============================================ */
  /* RESPONSIVE                                  */
  /* ============================================ */

  @media (max-width: 640px) {
    .product-card {
      border-radius: 0.5rem;
    }
    
    .product-content {
      padding: 0.5rem;
    }
    
    .product-price {
      font-size: 0.9rem;
    }
    
    .product-title {
      font-size: 0.8rem;
    }
    
    .product-btn {
      font-size: 0.8rem;
      padding: 0.3rem 0.75rem;
    }
  }

  @media (max-width: 400px) {
    .product-content {
      padding: 0.375rem;
    }
    
    .product-price {
      font-size: 0.8rem;
    }
    
    .product-title {
      font-size: 0.75rem;
    }
    
    .product-btn {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
    }
    
    .product-category {
      font-size: 0.5rem;
    }
    
    .product-badge {
      font-size: 0.5rem;
      padding: 0.1rem 0.375rem;
    }
  }
</style>