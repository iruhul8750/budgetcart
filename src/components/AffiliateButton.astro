---
export interface Props {
  url: string;
  text?: string;
  platform?: string;
}

const { url, text = "Check Price", platform = "Amazon" } = Astro.props;
---

<a 
  href={url} 
  target="_blank" 
  rel="nofollow sponsored"
  class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-orange-500/25 text-center group"
  onclick="gtag('event', 'affiliate_click', {'product_url': this.href, 'platform': '{{platform}}'});"
>
  <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
  </svg>
  🛒 {text} on {platform}
</a>